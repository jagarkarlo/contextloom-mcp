{
  "name": "contextloom-mcp",
  "version": "0.5.0",
  "description": "Bounded, redacted MCP context tools for GitLab, Jira, Confluence, Grafana, GitHub, configurable HTTPS APIs and durable Markdown notes. Every integration optional, every write confirmed.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/server.ts",
    "start": "node dist/server.js",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^16.5.0",
    "undici": "^7.9.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.0.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20.18.1"
  }
}
