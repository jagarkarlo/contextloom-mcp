# Use a GitLab personal access token with the minimum API access needed.
GITLAB_BASE_URL=https://gitlab.example.com
GITLAB_TOKEN=replace-with-your-gitlab-token

# Optional: talk to more than one GitLab host instead of GITLAB_BASE_URL/GITLAB_TOKEN above.
# Every gitlab_* tool then accepts an "instance" argument naming one of these; omitting it
# uses the first entry.
# GITLAB_INSTANCES=[{"name":"work","baseUrl":"https://gitlab.example.com","token":"..."},{"name":"personal","baseUrl":"https://gitlab.com","token":"..."}]

# This release supports Jira Server and Data Center personal access tokens.
JIRA_BASE_URL=https://jira.example.com
JIRA_API_TOKEN=replace-with-your-jira-personal-access-token

# Optional Confluence Server or Data Center integration. Set both values to enable its tools.
CONFLUENCE_BASE_URL=https://confluence.example.com
CONFLUENCE_API_TOKEN=replace-with-your-confluence-personal-access-token

# Optional Grafana integration. Set both values to enable its read-only dashboard tools.
GRAFANA_BASE_URL=https://grafana.example.com
GRAFANA_API_TOKEN=replace-with-your-grafana-service-account-token

# Optional GitHub integration. GITHUB_API_BASE_URL defaults to https://api.github.com.
# Use a fine-grained token with only the repository permissions required for the selected tools.
GITHUB_TOKEN=replace-with-your-github-token
# GITHUB_API_BASE_URL=https://github.example.com/api/v3

# Optional: only needed if reaching some of the hosts above requires a corporate proxy.
# Node's fetch does not read these the way curl does, so the server applies them itself,
# skipping any host covered by NO_PROXY.
# HTTPS_PROXY=http://proxy.example.com:8080
# NO_PROXY=.example.com,localhost

